# Most are optional. Do not put secrets in Git.
# RADAR_DB_PATH=.radar/startfund.sqlite
# Vercel deployment only: set both values in the Vercel project environment.
# TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
# TURSO_AUTH_TOKEN=
# RADAR_SOURCE_CONTACT=maintainer@example.com
# RADAR_MODEL_PROVIDER=gemini
# GOOGLE_GENERATIVE_AI_API_KEY=
# GROQ_API_KEY=
# AI_GATEWAY_API_KEY=
# RADAR_GATEWAY_MODEL=reflection/beam-free
# RADAR_AGENT_SECRET=
# RADAR_EVE_URL=http://127.0.0.1:3100
# RESEND_API_KEY=
# RADAR_EMAIL_FROM=
# RADAR_ALLOWED_RECIPIENT=
# RADAR_PUBLIC_ORIGIN=https://your-startfund-host.example
# Set all three to enable Stripe Pro billing. Keep secrets server-side.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID=
# Private beta sign-in requires RADAR_AUTH_SECRET, or RADAR_USAGE_SECRET when AUTH is unset.
# Use random values with at least 32 bytes of entropy.
# RADAR_AUTH_SECRET=
# RADAR_USAGE_SECRET=
# Operator API keys are comma-separated random values of at least 24 characters.
# RADAR_API_KEYS=
# RADAR_ADMIN_TOKEN=
